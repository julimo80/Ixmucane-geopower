---
import { loadData } from '../i18n/data';
import FavorabilityMap from './FavorabilityMap.astro';
import DrawingGallery from './DrawingGallery.astro';
import MufflerThermo from './MufflerThermo.astro';
import ServicePhotoGallery from './ServicePhotoGallery.astro';

const locale = Astro.currentLocale ?? 'en';
const flagship = loadData(locale, 'flagship');
const services = loadData(locale, 'services');
const servicesPage = loadData(locale, 'servicesPage');
---
<section id="services">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{servicesPage.eyebrow}</span>
      <h2>{servicesPage.heading}</h2>
      <p>{servicesPage.lead}</p>
    </div>

    <div class="svc-flagship">
      <div>
        <div class="flag-eyebrow"><span class="num mono">{flagship.num}</span><span class="eyebrow">{flagship.label}</span></div>
        <h3>{flagship.title}</h3>
        <p class="desc">{flagship.description}</p>
        <div class="tags">
          {flagship.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
      <FavorabilityMap />
    </div>

    <div class="svc-grid">
      {services.map((s) => (
        s.image ? (
          <div class="svc-item-featured">
            <div>
              <span class="idx">{s.idx}</span>
              <h3>{s.title}</h3>
              <p>{s.description}</p>
              {s.goto && <a class="goto" href={s.goto.href}>{s.goto.label} &rarr;</a>}
            </div>
            <div class="fav-card">
              <img src={`/images/${s.image.file}`} alt={s.image.alt} loading="lazy" />
              <div class="cap">
                <span>{s.image.fig}</span>
                <span>{s.image.note}</span>
              </div>
            </div>
          </div>
        ) : (
          <>
            <div class="svc-item">
              <span class="idx">{s.idx}</span>
              <div>
                <h4>{s.title}</h4>
                <p>{s.description}</p>
                {s.goto && <a class="goto" href={s.goto.href}>{s.goto.label} &rarr;</a>}
              </div>
            </div>
            {s.gallery && (
              <div class="svc-expansion">
                <DrawingGallery />
                <MufflerThermo />
              </div>
            )}
            {s.photoGallery && (
              <div class="svc-expansion">
                <ServicePhotoGallery dataKey={s.photoGallery} />
              </div>
            )}
          </>
        )
      ))}
    </div>
  </div>
</section>
