---
import { loadData } from '../i18n/data';
import FavorabilityMap from './FavorabilityMap.astro';

const locale = Astro.currentLocale ?? 'en';
const flagship = loadData(locale, 'flagship');
const services = loadData(locale, 'services');
const servicesPage = loadData(locale, 'servicesPage');
---
<section id="services">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{servicesPage.eyebrow}</span>
      <h2>{servicesPage.heading}</h2>
      <p>{servicesPage.lead}</p>
    </div>

    <div class="svc-flagship">
      <div>
        <div class="flag-eyebrow"><span class="num mono">{flagship.num}</span><span class="eyebrow">{flagship.label}</span></div>
        <h3>{flagship.title}</h3>
        <p class="desc">{flagship.description}</p>
        <div class="tags">
          {flagship.tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      </div>
      <FavorabilityMap />
    </div>

    <div class="svc-grid">
      {services.map((s) => (
        <div class="svc-item">
          <span class="idx">{s.idx}</span>
          <div>
            <h4>{s.title}</h4>
            <p>{s.description}</p>
            {s.goto && <a class="goto" href={s.goto.href}>{s.goto.label} &rarr;</a>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
