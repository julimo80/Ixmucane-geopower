---
import team from '../data/team.json';
---
<section id="team">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{team.eyebrow}</span>
      <h2>{team.heading}</h2>
      <p>{team.lead}</p>
    </div>

    <div class="team-grid">
      <div class="team-card">
        <div class="badge-line"><span class="eyebrow">Founding Team</span></div>
        <h3 style="font-size:18px;">{team.foundingTeam.title}</h3>
        <p style="margin-top:10px;color:var(--text-dim);font-size:14.5px;">{team.foundingTeam.note}</p>
      </div>
      <div class="team-card">
        <div class="badge-line"><span class="eyebrow">Publications</span></div>
        <div class="pub-list" style="margin-top:6px;">
          {team.publications.map((p) => (
            <div class="pub"><div class="t">{p.title}</div><div class="m">{p.meta}</div></div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
