---
import { Image } from 'astro:assets';
import caseStudies from '../data/caseStudies.json';
import combinedChart from '../assets/paper/combined-net-power.png';
---
<section id="case-studies">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Field Log</span>
      <h2>Selected reservoir modelling engagements.</h2>
      <p>Structured the way we hand work back to clients: the brief, the geological problem, how we modelled it, and what it changed about the field's development plan.</p>
    </div>

    <div class="draft-note">
      <span>&#9888;</span>
      <span><strong>Mixed status.</strong> LOG 01–02 are illustrative placeholders pending client confirmation. LOG 03 is real, from our own in-preparation research manuscript (not yet peer-reviewed) — see its source note below.</span>
    </div>

    <div class="case-list">
      {caseStudies.map((c) => (
        <article class="case">
          <div class="case-rail">
            <span class="log">{c.log}</span>
            {c.badge ? <span class="badge">{c.badge}</span> : c.draft && <span class="badge">Draft</span>}
          </div>
          <div class="case-body">
            <h3>{c.title}</h3>
            <span class="loc">{c.loc}</span>
            <div class="case-stages">
              <div class="stage"><div class="t">Brief</div><p>{c.brief}</p></div>
              <div class="stage"><div class="t">Challenge</div><p>{c.challenge}</p></div>
              <div class="stage"><div class="t">Method</div><p>{c.method}</p></div>
              <div class="stage"><div class="t">Outcome</div><p>{c.outcome}</p></div>
            </div>

            {c.hasChart && (
              <div class="case-chart">
                <div class="figure">
                  <Image src={combinedChart} alt="Combined net power output forecast, 25-year horizon, 293-sample ensemble with P10/P50/P90 bands" width={1800} />
                </div>
                <p class="figcap">{c.chartCaption}</p>
                {c.stats && (
                  <div class="case-stats">
                    {c.stats.map((s) => (
                      <div class="case-stat">
                        <span class="case-stat-label">{s.label}</span>
                        <span class="case-stat-value">{s.value}</span>
                      </div>
                    ))}
                  </div>
                )}
                {c.statsNote && <p class="case-stats-note">{c.statsNote}</p>}
              </div>
            )}
            {c.source && <p class="case-source">{c.source}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
