---
import { Image } from 'astro:assets';
import { loadData } from '../i18n/data';
import combinedChart from '../assets/paper/combined-net-power.png';

const caseStudies = loadData(Astro.currentLocale ?? 'en', 'caseStudies');
const { stageLabels } = caseStudies;
---
<section id="case-studies">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{caseStudies.eyebrow}</span>
      <h2>{caseStudies.heading}</h2>
      <p>{caseStudies.lead}</p>
    </div>

    <div class="draft-note">
      <span>&#9888;</span>
      <span><strong>{caseStudies.draftNote.strong}</strong> {caseStudies.draftNote.text}</span>
    </div>

    <div class="case-list">
      {caseStudies.items.map((c) => (
        <article class="case">
          <div class="case-rail">
            <span class="log">{c.log}</span>
            {c.badge ? <span class="badge">{c.badge}</span> : c.draft && <span class="badge">{caseStudies.draftBadge}</span>}
          </div>
          <div class="case-body">
            <h3>{c.title}</h3>
            <span class="loc">{c.loc}</span>
            <div class="case-stages">
              <div class="stage"><div class="t">{stageLabels.brief}</div><p>{c.brief}</p></div>
              <div class="stage"><div class="t">{stageLabels.challenge}</div><p>{c.challenge}</p></div>
              <div class="stage"><div class="t">{stageLabels.method}</div><p>{c.method}</p></div>
              <div class="stage"><div class="t">{stageLabels.outcome}</div><p>{c.outcome}</p></div>
            </div>

            {c.hasChart && (
              <div class="case-chart">
                <div class="figure">
                  <Image src={combinedChart} alt="Combined net power output forecast, 25-year horizon, 293-sample ensemble with P10/P50/P90 bands" width={1800} />
                </div>
                <p class="figcap">{c.chartCaption}</p>
                {c.stats && (
                  <div class="case-stats">
                    {c.stats.map((s) => (
                      <div class="case-stat">
                        <span class="case-stat-label">{s.label}</span>
                        <span class="case-stat-value">{s.value}</span>
                      </div>
                    ))}
                  </div>
                )}
                {c.statsNote && <p class="case-stats-note">{c.statsNote}</p>}
              </div>
            )}
            {c.source && <p class="case-source">{c.source}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
