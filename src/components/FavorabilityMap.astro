---
import flagship from '../data/flagship.json';
import fields from '../data/fields.json';
---
<div class="fav-card">
  <svg viewBox="0 0 480 380" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Illustrative geothermal favorability heatmap over a stylized Central American landmass, marking Guatemala's known geothermal fields and prospects">
    <defs>
      <clipPath id="landmass">
        <path d="M 70 46 L 150 24 L 226 58 L 296 46 L 372 100 L 416 172 L 396 252 L 338 316 L 258 338 L 182 300 L 126 258 L 78 198 L 46 118 Z"/>
      </clipPath>
      <filter id="heatBlur" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="16"/>
      </filter>
      {fields.map((f) => (
        <radialGradient id={`heat-${f.name.replace(/\s+/g, '')}`} cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color={`var(--fav-${f.tier})`} stop-opacity={f.tier >= 5 ? 0.95 : f.tier === 4 ? 0.85 : 0.7}/>
          <stop offset="1" stop-color={`var(--fav-${f.tier})`} stop-opacity="0"/>
        </radialGradient>
      ))}
    </defs>

    <g clip-path="url(#landmass)">
      <rect x="20" y="10" width="440" height="350" fill="var(--fav-1)"/>
      <g filter="url(#heatBlur)">
        {fields.map((f) => (
          <circle cx={f.x} cy={f.y} r={f.tier >= 5 ? 62 : f.tier === 4 ? 52 : 42} fill={`url(#heat-${f.name.replace(/\s+/g, '')})`}/>
        ))}
      </g>
    </g>

    <path d="M 70 46 L 150 24 L 226 58 L 296 46 L 372 100 L 416 172 L 396 252 L 338 316 L 258 338 L 182 300 L 126 258 L 78 198 L 46 118 Z"
          fill="none" stroke="var(--border)" stroke-width="1.6"/>
    <path d="M 100 65 Q 220 160, 355 300" stroke="var(--text-dim)" stroke-width="1" stroke-dasharray="2 4" fill="none" opacity="0.5"/>

    {fields.map((f) => (
      <>
        <circle cx={f.x} cy={f.y} r="3.5" fill="var(--text)"/>
        <text x={f.x + 8} y={f.y - 2} class="mono" font-size="10" fill="var(--text)">{f.name}</text>
      </>
    ))}

    <text x="34" y="30" class="mono" font-size="11" fill="var(--text-dim)" letter-spacing="1">GUATEMALA</text>
  </svg>
  <div class="fav-legend">
    <span>Lower</span>
    <div class="bar"></div>
    <span>Higher favorability</span>
  </div>

  <div class="field-key">
    {fields.map((f) => (
      <div class="field-key-item">
        <span class="dot" style={`background:var(--fav-${f.tier})`}></span>
        <div>
          <div class="name">{f.name} <span class="status">{f.status}</span></div>
          <div class="note">{f.note}</div>
        </div>
      </div>
    ))}
  </div>
  <p class="field-source">Field status and figures from public sources (operator/press releases, academic country updates) as of 2026 — not derived from our own analysis. The favorability shading itself is illustrative.</p>

  <div class="cap">
    <span>{flagship.mapCaption.fig}</span>
    <span>{flagship.mapCaption.note}</span>
  </div>
</div>
