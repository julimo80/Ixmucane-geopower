---
import { loadData } from '../i18n/data';
const pages = loadData(Astro.currentLocale ?? 'en', 'pages');
---
<section class="overview">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{pages.eyebrow}</span>
      <h2>{pages.heading}</h2>
    </div>
    <div class="overview-grid">
      {pages.items.map((p) => (
        <a class="overview-card" href={p.href}>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <span class="overview-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>
