---
import { Image } from 'astro:assets';
import tech from '../data/technology.json';
import geoModelImg from '../assets/paper/geological-reservoir-model.png';
import crossSectionImg from '../assets/paper/tecuamburro-permeability-cross-section.png';
import espImg from '../assets/paper/esp-pump-sizing.png';

const { methodology, pipeline } = tech;

const figureImages = {
  geomodel: geoModelImg,
  permeability: crossSectionImg,
  gbop: espImg,
} as const;
const figureAlts = {
  geomodel: "Two-panel figure: (A) 3D geological model of the Tecuamburro field in Leapfrog, (B) the same volume discretised as a numerical reservoir simulation mesh",
  permeability: "Numerical reservoir model cross-sections through Tecuamburro (A-A') and Infiernitos (B-B'), coloured by vertical permeability, showing clay-cap geometry and well locations",
  gbop: "Electric submersible pump completion schematic with gas-breakout pressure and water-only NPSH thresholds vs. pump setting depth",
} as const;
---

<section id="technology">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">{tech.eyebrow}</span>
      <h2>{tech.heading}</h2>
      <p>{tech.lead}</p>
    </div>

    <div class="pipeline-block">
      <span class="eyebrow">{pipeline.eyebrow}</span>
      <h3>{pipeline.heading}</h3>
      <div class="pipeline">
        {pipeline.steps.map((s, i) => (
          <>
            <div class="pipeline-step">
              <span class="pipeline-num">{String(i + 1).padStart(2, '0')}</span>
              <h4>{s.title}</h4>
              <p>{s.description}</p>
            </div>
            {i < pipeline.steps.length - 1 && <div class="pipeline-arrow" aria-hidden="true"></div>}
          </>
        ))}
      </div>
    </div>

    <div class="tech-cols">
      <div class="cap-list">
        {tech.capabilities.map((c) => (
          <div class="cap-item">
            <span class="idx">{c.idx}</span>
            <div>
              <h3>{c.title}</h3>
              <p>{c.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="eq-panel">
        <span class="eyebrow">Governing Equations</span>
        <h3>What the simulator actually solves</h3>
        <div class="eq">
          <span class="label">Mass &amp; energy conservation, per grid block n</span>
          d/dt &#8747;<sub>Vn</sub> M dV &#160;=&#160; &#8747;<sub>&Gamma;n</sub> F&#8901;n&#8202;d&#915; &#160;+&#160; &#8747;<sub>Vn</sub> q dV
        </div>
        <div class="eq">
          <span class="label">Darcy flux, phase &beta;</span>
          F<sub>&beta;</sub> &#160;=&#160; &#8722; k k<sub>r&beta;</sub> / &mu;<sub>&beta;</sub> &#160;&#8901;&#160; (&#8711;P<sub>&beta;</sub> &#8722; &rho;<sub>&beta;</sub> g)
        </div>
        <p class="foot">M — mass/energy per volume · F — flux across face &Gamma;n · q — sink/source · k — permeability · k<sub>r&beta;</sub> — relative permeability</p>
      </div>
    </div>

    <div class="method-section">
      <div class="section-head">
        <span class="eyebrow">{methodology.eyebrow}</span>
        <h2 style="font-size:24px;">{methodology.heading}</h2>
        <p>{methodology.lead}</p>
      </div>

      <div class="method-grid">
        {methodology.items.map((item) => (
          <div class:list={['method-card', item.key === 'gbop' && 'method-card-sm']}>
            <div class="figure">
              <Image
                src={figureImages[item.key as keyof typeof figureImages]}
                alt={figureAlts[item.key as keyof typeof figureAlts]}
                width={item.key === 'gbop' ? 900 : 1800}
              />
            </div>
            <p class="figcap">{item.figcap}</p>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
