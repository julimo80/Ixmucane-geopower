---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import logoIcon from '../assets/paper/logo-icon-2.png';
---
<nav class="top">
  <div class="wrap nav-inner">
    <div class="brand">
      <Image class="mark" src={logoIcon} alt="" width={64} />
      <span>{site.name}<span class="sub" style="display:block;margin-top:1px;">{site.tagline}</span></span>
    </div>
    <div class="navlinks">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
</nav>
