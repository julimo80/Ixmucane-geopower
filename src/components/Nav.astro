---
import { Image } from 'astro:assets';
import { loadData } from '../i18n/data';
import logoIcon from '../assets/paper/logo-icon-2.png';

const locale = Astro.currentLocale ?? 'en';
const site = loadData(locale, 'site');

// Every page now has an es/ counterpart at the same sub-path, so the
// switcher just adds/strips the "/es" prefix on the current path.
const path = Astro.url.pathname;
const otherLocaleHref = locale === 'es' ? (path.replace(/^\/es/, '') || '/') : `/es${path}`;
const otherLocaleLabel = locale === 'es' ? 'EN' : 'ES';
---
<nav class="top">
  <div class="wrap nav-inner">
    <a class="brand" href={locale === 'es' ? '/es/' : '/'}>
      <Image class="mark" src={logoIcon} alt="" width={64} />
      <span>{site.name}<span class="sub" style="display:block;margin-top:1px;">{site.tagline}</span></span>
    </a>
    <div class="navlinks">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href={otherLocaleHref} class="lang-switch">{otherLocaleLabel}</a>
    </div>
  </div>
</nav>
