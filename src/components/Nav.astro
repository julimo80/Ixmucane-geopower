---
import site from '../data/site.json';
---
<nav class="top">
  <div class="wrap nav-inner">
    <div class="brand">
      <svg class="mark" viewBox="0 0 32 32" fill="none">
        <circle cx="16" cy="16" r="15" stroke="var(--accent)" stroke-width="1.4"/>
        <path d="M16 6 C 11 12, 21 14, 16 20 C 12 24, 16 27, 16 27" stroke="var(--accent-2)" stroke-width="1.6" fill="none" stroke-linecap="round"/>
      </svg>
      <span>{site.name}<span class="sub" style="display:block;margin-top:1px;">{site.tagline}</span></span>
    </div>
    <div class="navlinks">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
  </div>
</nav>
