---
import { Image } from 'astro:assets';
import site from '../data/site.json';
import crossSection from '../assets/paper/tecuamburro-permeability-cross-section.png';
const { hero } = site;
---
<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.headlinePre} <em>{hero.headlineEm}</em> {hero.headlinePost}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
    </div>
    <div class="hero-art">
      <Image src={crossSection} alt="Numerical reservoir model cross-sections through Tecuamburro (A-A') and Infiernitos (B-B'), coloured by vertical permeability, showing clay-cap geometry and well locations" width={1400} />
      <div class="cap">
        <span>Fig. 01 — Reservoir Model Cross-Sections (Tecuamburro A–A′, Infiernitos B–B′)</span>
        <span>From our own field work</span>
      </div>
    </div>
  </div>
</header>
