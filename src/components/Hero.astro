---
import site from '../data/site.json';
import GeothermalMark from './GeothermalMark.astro';
const { hero } = site;
---
<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">{hero.eyebrow}</span>
      <h1>{hero.headlinePre} <em>{hero.headlineEm}</em> {hero.headlinePost}</h1>
      <p class="lead">{hero.lead}</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.label}</a>
        <a class="btn btn-secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.label}</a>
      </div>
    </div>
    <div class="hero-art hero-art-mark">
      <GeothermalMark />
      <div class="cap">
        <span>Production (red) — reinjection (blue)</span>
        <span>Illustrative schematic, not a specific well design</span>
      </div>
    </div>
  </div>
</header>
